<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shape ngoài cùng -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />

            <solid android:color="#664A42" />


        </shape>
    </item>

    <!-- Shape thứ hai, nằm bên trong shape đầu -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">

        <shape android:shape="rectangle">
            <corners android:radius="44dp" />

            <solid android:color="#F6ECE6" />

        </shape>
    </item>

    <!-- Shape thứ ba, nằm trong cùng -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">

        <shape android:shape="rectangle">
            <corners android:radius="38dp" />
            <stroke android:color="#DFC1B1" android:width="1dp"/>

            <solid android:color="#EAD8CE" />
        </shape>
    </item>

</layer-list>
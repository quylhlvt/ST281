<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginVertical="@dimen/dimension_4"
    android:layout_marginEnd="@dimen/dimension_8"

    >

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/frame1"
        android:layout_width="@dimen/dimension_0"
        app:cardCornerRadius="@dimen/dimension_8"
        android:layout_height="match_parent"
        android:elevation="@dimen/dimension_2"
        app:strokeWidth="@dimen/dimension_0"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent">




            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:background="@color/app_color2"
                android:src="@drawable/img_permission"/>


            <!--            imvImage-->


            <!--        sflShimmer-->


    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

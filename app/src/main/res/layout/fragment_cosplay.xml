<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    tools:context="com.fff.a.ui.main.cosplay.CosplayFragment">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.595" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:scaleType="fitXY"
        android:src="@drawable/img_view_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom1" />

 <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />
    <View
        android:id="@+id/view5"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="0.18:1.83"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottom2"/>
    <View
        android:id="@+id/view6"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="0.18:1.83"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottom2"/>
    <View
        android:id="@+id/view7"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="3.6:0.18"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <FrameLayout
        android:layout_width="0dp"
        android:background="@drawable/bg_txt_cosplay"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintTop_toBottomOf="@+id/view7"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottom2"
        app:layout_constraintEnd_toStartOf="@+id/view6"
        app:layout_constraintStart_toEndOf="@+id/view5">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_14"

            android:text="@string/tvCosplay"
            android:gravity="center"
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/app_color"
            android:fontFamily="@font/londrina_solid_regular"/>
    </FrameLayout>


    <FrameLayout
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottom1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:cardBackgroundColor="@color/transparent"

        android:id="@+id/mater3"
        android:elevation="@dimen/dimension_2"
        >
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:src="@drawable/img_permission" />
        <ImageView
            android:id="@+id/imageGif"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3.6:0.4"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom2"
        app:layout_constraintVertical_bias="0.0">

        <View
            android:id="@+id/view2"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            app:layout_constraintDimensionRatio="3.2:4"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/view3"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            app:layout_constraintDimensionRatio="3.2:4"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/view4"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            app:layout_constraintDimensionRatio="0.8:4"
            app:layout_constraintEnd_toStartOf="@+id/show"
            app:layout_constraintStart_toEndOf="@+id/random" />

        <FrameLayout
            android:id="@+id/random"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_random"
            app:layout_constraintDimensionRatio="1.44:0.4"
            app:layout_constraintEnd_toStartOf="@+id/view4"
            app:layout_constraintStart_toEndOf="@+id/view2"
            app:strokeColor="@color/app_color2"
            app:strokeWidth="@dimen/dimension_1">

            <TextView
                android:id="@+id/txtRandom"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/londrina_solid_regular"
                android:gravity="center"
                android:text="@string/random"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/show"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:alpha="0.5"
            android:background="@drawable/bg_btn_cosplay"
            android:enabled="false"
            app:layout_constraintDimensionRatio="1.44:0.4"
            app:layout_constraintEnd_toStartOf="@+id/view3"
            app:layout_constraintStart_toEndOf="@+id/view4"
            app:strokeColor="@color/app_color2"
            app:strokeWidth="@dimen/dimension_1">


            <TextView
                android:id="@+id/txtShow"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/londrina_solid_regular"
                android:gravity="center"
                android:text="@string/cosplay"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16" />

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>

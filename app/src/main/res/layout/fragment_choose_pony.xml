<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.createPony.ChoosePonyFragment">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/app_color"
        app:cardCornerRadius="50dp"
        android:id="@+id/mater1"
        android:elevation="1dp"
        app:strokeWidth="0dp"/>

         <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/mater1"
        app:layout_constraintBottom_toBottomOf="@+id/mater1"
             app:layout_constraintStart_toStartOf="@+id/mater1"
             app:layout_constraintEnd_toEndOf="@+id/mater1"
        android:layout_margin="6dp"
        app:cardBackgroundColor="@color/app_color2"
        app:cardCornerRadius="44dp"
        android:id="@+id/mater2"
        android:elevation="2dp"
        app:strokeWidth="0dp"/>

   <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/mater2"
        app:layout_constraintBottom_toBottomOf="@+id/mater2"
             app:layout_constraintStart_toStartOf="@+id/mater2"
             app:layout_constraintEnd_toEndOf="@+id/mater2"
        android:layout_margin="6dp"
        app:cardBackgroundColor="@color/app_color3"
        app:cardCornerRadius="44dp"
        android:id="@+id/mater3"
        android:elevation="2dp"
       app:strokeColor="@color/app_color4"
        app:strokeWidth="1dp">



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleChoose"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="1dp"
        android:layout_marginTop="5dp"
        app:spanCount="3"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        android:layout_marginHorizontal="5dp"
        tools:listitem="@layout/item_choose" />
   </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

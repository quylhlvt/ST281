<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.random.RandomFragment">


    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/app_color"
        app:cardCornerRadius="50dp"
        android:id="@+id/mater1"
        android:elevation="1dp"
        app:strokeWidth="0dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/mater1"
        app:layout_constraintBottom_toBottomOf="@+id/mater1"
        app:layout_constraintStart_toStartOf="@+id/mater1"
        app:layout_constraintEnd_toEndOf="@+id/mater1"
        android:layout_margin="6dp"
        app:cardBackgroundColor="@color/app_color2"
        app:cardCornerRadius="44dp"
        android:id="@+id/mater2"
        android:elevation="2dp"
        app:strokeWidth="0dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/mater2"
        app:layout_constraintBottom_toBottomOf="@+id/mater2"
        app:layout_constraintStart_toStartOf="@+id/mater2"
        app:layout_constraintEnd_toEndOf="@+id/mater2"
        android:layout_margin="6dp"
        app:cardBackgroundColor="@color/app_color3"
        app:cardCornerRadius="44dp"
        android:id="@+id/mater3"
        android:elevation="2dp"
        app:strokeColor="@color/app_color4"
        app:strokeWidth="1dp">
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_permission" />

    </com.google.android.material.card.MaterialCardView>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/random"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="84dp"
        android:layout_marginTop="50dp"
        app:layout_constraintDimensionRatio="1.56:0.40"
        app:layout_constraintEnd_toEndOf="@+id/mater3"
        app:layout_constraintStart_toStartOf="@+id/mater3"
        app:layout_constraintTop_toBottomOf="@+id/mater3"
        app:strokeColor="@color/app_color2"
        app:strokeWidth="1dp">
        <ImageView
            android:id="@+id/imgRandomBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/frame_bg_type_lang"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/imgRandomFor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_btn_type_selected" />
        <ImageView
            android:id="@+id/imgIcRandom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@+id/imgRandomFor"
            android:layout_marginStart="15dp"
            android:layout_marginVertical="6dp"
            app:layout_constraintTop_toTopOf="@+id/imgRandomFor"
            app:layout_constraintBottom_toBottomOf="@+id/imgRandomFor"
            android:layout_marginEnd="2dp"

            app:layout_constraintDimensionRatio="1:1"
            android:scaleType="fitXY"
            android:src="@drawable/ic_ramdom" />
        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
            android:id="@+id/txtShow"
            style="@style/single_marquee"
            android:layout_width="0dp"
            android:layout_marginStart="-8dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/imgIcRandom"
            app:layout_constraintEnd_toEndOf="@+id/imgRandomFor"
            app:layout_constraintTop_toTopOf="@+id/imgRandomFor"
            app:layout_constraintBottom_toBottomOf="@+id/imgRandomFor"
            android:fontFamily="@font/atma_bold"
            android:gravity="center"
            android:text="@string/random"
            android:textColor="@color/white"
            app:outerStrokeColor="@color/app_color"
            app:outerStrokeWidth="2dp"
            android:textSize="20sp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
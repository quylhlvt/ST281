<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <!-- Container chính — flat ConstraintLayout, không lồng -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flMain"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="2dp">



        <ImageView
            android:id="@+id/imgLangFor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:scaleType="fitXY"
            android:src="@drawable/frame_unselect_language" />

        <ImageView
            android:id="@+id/imvFlag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginStart="16dp"
            android:layout_marginVertical="12dp"
            android:src="@drawable/ic_flag_english"
            app:layout_constraintBottom_toBottomOf="@+id/imgLangFor"
            app:layout_constraintStart_toStartOf="@+id/imgLangFor"
            app:layout_constraintTop_toTopOf="@+id/imgLangFor" />

        <ImageView
            android:id="@+id/btnRadio"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginEnd="14dp"
            android:layout_marginVertical="8dp"
            android:src="@drawable/ic_un_select_lang"
            app:layout_constraintBottom_toBottomOf="@+id/imgLangFor"
            app:layout_constraintEnd_toEndOf="@+id/imgLangFor"
            app:layout_constraintTop_toTopOf="@+id/imgLangFor" />

        <TextView
            android:id="@+id/tvLang"
            style="@style/single_marquee"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/carter_one_regular"
            android:gravity="start|center_vertical"
            android:text="@string/language"
            android:textColor="@color/app_color"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/imvFlag"
            app:layout_constraintEnd_toStartOf="@+id/btnRadio"
            app:layout_constraintStart_toEndOf="@+id/imvFlag"
            app:layout_constraintTop_toTopOf="@+id/imvFlag"
            app:outerStrokeColor="@color/app_color"
            app:outerStrokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>
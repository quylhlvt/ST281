    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar2" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:layout_marginTop="-10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="0dp">

        <FrameLayout
            android:id="@+id/rlCharacter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="5dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginVertical="20dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
            app:layout_constraintDimensionRatio="0.5:2.78"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextViewPermission2
                android:id="@+id/tvPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:fontFamily="@font/carter_one_regular"
                android:text="0%"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/layoutProgress"
                app:layout_constraintStart_toStartOf="@+id/layoutProgress"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="3dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutProgress"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginVertical="10dp"
                android:elevation="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/tvPercent"
                app:layout_constraintDimensionRatio="0.2:2.5"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 1. Track nền cam - elevation thấp nhất -->
                <ImageView
                    android:id="@+id/progressTrack"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:elevation="0dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_progress_track"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <!-- 2. Fill tím rectangle - trượt từ dưới lên -->
                <ImageView
                    android:id="@+id/progressFill"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginBottom="10dp"
                    android:elevation="1dp"
                    android:scaleType="fitXY"
                    android:scaleY="0"
                    android:src="@drawable/bg_progress_match"
                    app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                    app:layout_constraintEnd_toEndOf="@+id/progressTrack"
                    app:layout_constraintStart_toStartOf="@+id/progressTrack"
                    app:layout_constraintTop_toTopOf="@id/progressTrack" />

                <!-- 3. Bottom cố định ở đáy - đè lên fill -->
                <ImageView
                    android:id="@+id/progressTrackBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:elevation="2dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_progress_track_bottom"
                    android:translationY="-3dp"
                    app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- 4. Sao - elevation cao nhất, bám đỉnh fill -->
                <ImageView
                    android:id="@+id/imgStar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:elevation="3dp"
                    android:src="@drawable/ic_star"
                    android:translationY="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frame_rando_all"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintDimensionRatio="3.28:0.4"
            app:layout_constraintBottom_toTopOf="@+id/rcvNav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Icon mở màu — click để hiện rcvColor -->
            <ImageView
                android:id="@+id/imgChangColor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_color_show"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Icon random -->
            <ImageView
                android:id="@+id/imgRandom"
                android:layout_width="40dp"
                android:layout_height="0dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                android:src="@drawable/ic_ramdom_cus"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Container màu ở giữa — y hệt llColor trong Activity -->
            <ImageView
                android:id="@+id/imgScale"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="invisible"
                android:src="@drawable/ic_scale_cus_none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/imgRandom"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:elevation="1dp"
                android:id="@+id/llColor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="14dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imgScale"
                app:layout_constraintStart_toEndOf="@+id/imgChangColor"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/app_color"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#F7EDE7"
                    app:layout_constraintStart_toStartOf="@+id/cardColor"
                    app:layout_constraintTop_toTopOf="@+id/cardColor"
                    app:layout_constraintBottom_toBottomOf="@+id/cardColor"
                    app:layout_constraintEnd_toEndOf="@+id/cardColor">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_10_stroke_linear_color"/>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardColor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/transparent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="0dp"
                        android:layout_marginVertical="8dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="12dp"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_color" />
                    </RelativeLayout>

                    <!-- imvEndColor — đóng llColor -->
                    <ImageView
                        android:visibility="gone"
                        android:id="@+id/end"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:elevation="3dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/img_end_color"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frameLayer"
            android:background="@color/app_color"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.38">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="20dp"
                android:id="@+id/mater2"
                android:elevation="2dp"
                app:strokeWidth="0dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@+id/mater2"
                app:layout_constraintBottom_toBottomOf="@+id/mater2"
                app:layout_constraintStart_toStartOf="@+id/mater2"
                app:layout_constraintEnd_toEndOf="@+id/mater2"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/app_color3"
                app:cardCornerRadius="14dp"
                android:id="@+id/mater3"
                android:elevation="1dp"
                app:strokeColor="@color/app_color4"
                app:strokeWidth="1dp">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvPart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="3dp"
                    android:paddingTop="3dp"
                    android:elevation="1dp"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="5"
                    tools:itemCount="40"
                    tools:listitem="@layout/item_layer" />
                <LinearLayout
                    android:id="@+id/frameScale"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:elevation="5dp"
                    android:focusable="true"
                    android:visibility="gone"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@+id/rcvNav"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/frameLayer">

                    <FrameLayout
                        android:id="@+id/btnResetScale"
                        android:layout_width="120dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="12dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/btn_reset_scale"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                            android:id="@+id/txtReset"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/carter_one_regular"
                            android:gravity="center"
                            android:text="@string/reset"
                            app:outerStrokeColor="@color/app_color"
                            app:outerStrokeWidth="2dp"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                    </FrameLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="19dp"
                        android:layout_marginVertical="16dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/constraintLayout4"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginEnd="18dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.7:1.22"
                            app:layout_constraintEnd_toStartOf="@+id/constraintLayout5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:orientation="vertical"
                                android:weightSum="92"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintDimensionRatio="0.7:0.92"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:id="@+id/ratioRight"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="38"
                                    android:src="@drawable/ratio_right" />

                                <Space
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="16" />

                                <ImageView
                                    android:id="@+id/ratioLeft"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="38"
                                    android:src="@drawable/ratio_left" />
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/constraintLayout5"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginHorizontal="95dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/transitionLeft"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:src="@drawable/transition_left"
                                app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                                app:layout_constraintDimensionRatio="1:1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/transitionTop" />

                            <ImageView
                                android:id="@+id/transitionRight"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:src="@drawable/transition_right"
                                app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                                app:layout_constraintDimensionRatio="1:1"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/transitionTop" />

                            <ImageView
                                android:id="@+id/transitionTop"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:src="@drawable/transition_top"
                                app:layout_constraintDimensionRatio="1:1"
                                app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                                app:layout_constraintStart_toEndOf="@+id/transitionLeft"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/transitionBottom"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:src="@drawable/transition_bottom"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintDimensionRatio="1:1"
                                app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                                app:layout_constraintStart_toEndOf="@+id/transitionLeft" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/constraintLayout3"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="18dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.7:1.22"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/constraintLayout5"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:orientation="vertical"
                                android:weightSum="92"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintDimensionRatio="0.7:0.92"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:id="@+id/scalePlus"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="38"
                                    android:src="@drawable/scale_plus" />

                                <Space
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="16" />

                                <ImageView
                                    android:id="@+id/scaleMinus"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="38"
                                    android:src="@drawable/scale_minus" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNav"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="4:0.38"
            android:clipToPadding="false"
            android:elevation="1dp"
            android:orientation="horizontal"

            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/frameLayer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:listitem="@layout/item_bottom_custom" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/materialSmall"
        android:layout_width="84dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"

        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/constraintLayout">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="1dp"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            app:cardBackgroundColor="@color/app_color2"
            app:cardCornerRadius="11dp"
            android:id="@+id/materMini2"
            android:elevation="2dp"
            app:strokeWidth="0dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@+id/materMini2"
            app:layout_constraintBottom_toBottomOf="@+id/materMini2"
            app:layout_constraintStart_toStartOf="@+id/materMini2"
            app:layout_constraintEnd_toEndOf="@+id/materMini2"
            android:layout_margin="1dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="10dp"
            android:id="@+id/materMini3"
            android:elevation="2dp"
            app:strokeColor="@color/app_color4"
            app:strokeWidth="1dp">
            <ImageView
                android:id="@+id/imvImage2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_permission" />

        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imgShowBig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imgShow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materBig1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="1dp"
                app:cardBackgroundColor="@color/app_color"
                app:cardCornerRadius="50dp"

                app:strokeWidth="0dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@+id/materBig1"
                app:layout_constraintBottom_toBottomOf="@+id/materBig1"
                app:layout_constraintStart_toStartOf="@+id/materBig1"
                app:layout_constraintEnd_toEndOf="@+id/materBig1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="44dp"
                android:id="@+id/materBig2"
                android:elevation="2dp"
                app:strokeWidth="0dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@+id/materBig2"
                app:layout_constraintBottom_toBottomOf="@+id/materBig2"
                app:layout_constraintStart_toStartOf="@+id/materBig2"
                app:layout_constraintEnd_toEndOf="@+id/materBig2"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="38dp"
                android:id="@+id/materBig3"
                android:elevation="2dp"
                app:strokeColor="@color/app_color4"
                app:strokeWidth="1dp">
                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_permission" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="-5dp"
            android:src="@drawable/ic_close_guide"
            app:layout_constraintEnd_toEndOf="@+id/imgShow"
            app:layout_constraintTop_toTopOf="@+id/imgShow" />
    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutWin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:focusable="true"
        android:clipToPadding="false"
        android:clipToOutline="false"
        android:clickable="true"
        android:visibility="gone"
        android:focusableInTouchMode="true"
        android:clipChildren="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/img_bg_mycreation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextViewPermission2
                android:id="@+id/tvTitleWin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/carter_one_regular"
                android:gravity="center"
                android:text="@string/congratulation"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:layout_constraintTop_toTopOf="parent"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="5dp" />

            <ImageView
                android:id="@+id/imgAvatar_Win"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="100dp"
                android:src="@drawable/img_win_avatar"
                app:layout_constraintDimensionRatio="1.19:1.34"
                app:layout_constraintTop_toBottomOf="@+id/tvTitleWin"/>
            <FrameLayout
                android:id="@+id/txtcontent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/imgAvatar_Win">
                <TextView
                    android:id="@+id/txtcontentWin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_color"
                    android:textSize="18sp"
                    android:maxLines="2"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/congratulations_on_completing_the_challenge"
                    />
                <TextView
                    android:id="@+id/txtcontentLost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_color"
                    style="@style/single_marquee"
                    android:singleLine="true"
                    android:visibility="gone"
                    android:textSize="18sp"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/keep_trying_harder"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnNextWin"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@+id/txtcontent"
                android:layout_marginHorizontal="100dp"
                android:background="@drawable/btn_win"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="28dp"
                android:layout_marginTop="10dp"
                app:layout_constraintDimensionRatio="1.56:0.4">
                <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                    android:id="@+id/txtNextWin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/next"
                    android:layout_marginHorizontal="2dp"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="5dp" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/countDown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:focusable="true"
        android:clickable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCountDown"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/app_color5"
            android:textSize="50sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
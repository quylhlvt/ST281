<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginHorizontal="3dp"
android:layout_marginBottom="6dp"
    android:layout_height="wrap_content">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialParent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="8dp"
        android:elevation="1dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="@color/app_color7"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/transparent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:cardCornerRadius="8dp"
      android:layout_margin="2dp"
      app:cardElevation="1.5dp"
      app:cardBackgroundColor="@color/app_color5"
      android:outlineAmbientShadowColor="#EBAD88"
      android:outlineSpotShadowColor="#EBAD88"
      app:strokeWidth="0dp">
      <ImageView
          android:id="@+id/imvImage"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:src="@drawable/img_permission"
          android:foreground="@drawable/foreground_img_bg"
          android:scaleType="centerCrop" />
      <ImageView
          android:visibility="gone"
          android:id="@+id/imvImageNone"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_none_item"/>
      <LinearLayout
          android:id="@+id/lnlAddItem"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:orientation="vertical"
          android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_add_item" />

        <!--                tvAddImage-->
        <TextView
            android:id="@+id/tvAddImage"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/carter_one_regular"
            android:gravity="center"
            android:text="@string/add_image"
            android:textColor="@color/app_color"
            android:textSize="9sp"
            tools:ignore="SmallSp" />
      </LinearLayout>

  </com.google.android.material.card.MaterialCardView>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      android:id="@+id/materiaForcus"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:elevation="3dp"
      android:visibility="gone"
      android:layout_margin="2dp"
      app:cardCornerRadius="8dp"
      app:cardBackgroundColor="@color/transparent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintDimensionRatio="1:1"
      app:layout_constraintEnd_toEndOf="parent"
      app:strokeColor="@color/app_color"
      app:strokeWidth="2dp"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    tools:context=".ui.main.home.HomeFragment">


    <!--    layoutActionBar-->
    <FrameLayout
        android:elevation="@dimen/dimension_2"
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ImageView
        android:id="@+id/title_home"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:elevation="@dimen/dimension_1"
        android:scaleType="centerCrop"
        android:layout_marginTop="@dimen/dimension_50_"
        android:src="@drawable/img_title_home"
        app:layout_constraintDimensionRatio="3.6:2.1935"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"/>


    <!--    scvMain-->
    <ScrollView
        android:id="@+id/scvMain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_20"
        android:layout_marginBottom="@dimen/dimension_0"
        android:elevation="@dimen/dimension_1"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_home">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/dimension_30"
            android:paddingHorizontal="@dimen/dimension_16">



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:background="@drawable/img_home"
                android:elevation="@dimen/dimension_2"
                app:layout_constraintDimensionRatio="3.28:0.9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv1"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/pony_maker"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_24"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:outerStrokeColor="@color/app_color"
                  />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnChallenge"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:background="@drawable/img_home"
                android:layout_marginTop="@dimen/dimension_16"
                android:elevation="@dimen/dimension_2"
                app:layout_constraintDimensionRatio="3.28:0.9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnCreate"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/dimension_0">




                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv2"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/challenge_food"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_24"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeJoinStyle="miter"
                    app:outerStrokeWidth="@dimen/dimension_2_5" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnRandom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:background="@drawable/img_home"
                android:layout_marginTop="@dimen/dimension_16"
                android:elevation="@dimen/dimension_2"
                app:layout_constraintDimensionRatio="3.28:0.9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnChallenge"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/dimension_0">




                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv3"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/food_random"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeJoinStyle="miter"
                    app:outerStrokeWidth="@dimen/dimension_2_5" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnMyAlbum"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginTop="@dimen/dimension_16"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_2"
                android:background="@drawable/img_home"
                app:layout_constraintDimensionRatio="3.28:0.9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnRandom"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/dimension_3">



                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv4"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center"
                    android:text="@string/my_creation"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                     />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_height="@dimen/dimension_0"
    app:layout_constraintDimensionRatio="3.6:0.9">
<View
    app:layout_constraintTop_toTopOf="parent"
    android:id="@+id/view1"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_0"
    app:layout_constraintDimensionRatio="3.6:0.4"/>
    <View
    app:layout_constraintBottom_toBottomOf="parent"
    android:id="@+id/view2"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_0"
    app:layout_constraintDimensionRatio="3.6:0.16"/>

    <!--    btnActionBarLeft-->
    <ImageView
        android:id="@+id/btnActionBarLeft"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginStart="@dimen/dimension_16"

        android:src="@drawable/back_app"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintStart_toStartOf="parent" />



    <ImageView
        android:id="@+id/btnActionBarCenter"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginEnd="@dimen/dimension_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/btnActionBarNextToRight"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

    <!--    btnActionBarCenter-->
    <ImageView
        android:id="@+id/btnActionBarCenter2"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight" />

    <!--    btnActionBarNextToRight-->
    <ImageView
        android:id="@+id/btnActionBarNextToRight"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginEnd="@dimen/dimension_16"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight" />

    <!--    btnActionBarRight-->
    <ImageView
        android:id="@+id/btnActionBarRight"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"

        app:layout_constraintTop_toBottomOf="@+id/view1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginEnd="@dimen/dimension_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--            btnActionBarRightText-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnActionBarRightText"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="0.52:0.4"
        android:visibility="gone"
        app:cardBackgroundColor="@color/app_color2"
        app:cardCornerRadius="@dimen/dimension_20"
        app:strokeWidth="@dimen/dimension_2"
        app:strokeColor="#FFB299"
        android:layout_marginEnd="@dimen/dimension_16"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarRight">
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/dimension_20"
    app:strokeColor="#FFD9CC"
    app:strokeWidth="@dimen/dimension_4"
    app:cardBackgroundColor="@color/transparent">

        <TextView
            android:id="@+id/tvRightText"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/londrina_solid_regular"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="@dimen/dimension_16" />
</com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

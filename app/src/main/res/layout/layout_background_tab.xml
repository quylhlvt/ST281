<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnlBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="226">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:padding="@dimen/dimension_6"
        android:layout_weight="46"
        android:elevation="@dimen/dimension_2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnBackgroundImage"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/dimension_3"
            android:layout_weight="1">


            <ImageView
                android:id="@+id/imgAddFor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/frame_select_add" />

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/btnBackgroundImageTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="@dimen/dimension_2"
                android:text="@string/image"
                android:fontFamily="@font/carter_one_regular"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_1_3"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16"
                tools:ignore="NestedWeights" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnBackgroundColor"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/dimension_3"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imgAddFor1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/frame_unselect_add" />

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/btnBackgroundColorTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="@dimen/dimension_2"
                android:text="@string/color"
                android:fontFamily="@font/carter_one_regular"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_1_3"
                android:textColor="@color/black3"
                android:textSize="@dimen/text_size_16" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_weight="180">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <RelativeLayout
                android:id="@+id/relative"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:gravity="center"
                app:layout_constraintDimensionRatio="3.36:0.33"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvtTittle"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:elevation="@dimen/dimension_2"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/item_tittle_background_image"
                    />

            </RelativeLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvBackgroundImage"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/dimension_4"
                app:layout_constraintTop_toBottomOf="@+id/relative"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginTop="@dimen/dimension_8"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="5"
                tools:listitem="@layout/item_background_image" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBackgroundColor"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_4"
            app:layout_constraintTop_toBottomOf="@+id/relative"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_8"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="5"
            tools:listitem="@layout/item_background_color" />
    </FrameLayout>

</LinearLayout>

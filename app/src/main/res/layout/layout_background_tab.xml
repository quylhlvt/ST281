<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnlBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/view3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginBottom="@dimen/dimension_0"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/linear"
        app:layout_constraintDimensionRatio="3.6:0.16"/>
    <LinearLayout
        android:id="@+id/linear"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="3.6:0.32"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:paddingHorizontal="@dimen/dimension_0"
        android:layout_weight="2"
        android:elevation="@dimen/dimension_2"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBackgroundImage"
            android:layout_width="@dimen/dimension_0"
            app:cardCornerRadius="@dimen/dimension_8_1"
            app:cardBackgroundColor="@color/app_color2"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:strokeWidth="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_4"
            android:layout_weight="1">



            <TextView
                android:id="@+id/btnBackgroundImageTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="@dimen/dimension_2"
                android:text="@string/image"
                android:fontFamily="@font/londrina_solid_regular"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_3"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16"
                tools:ignore="NestedWeights" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBackgroundColor"
            android:layout_width="@dimen/dimension_0"
            app:cardCornerRadius="@dimen/dimension_8_1"
            app:strokeWidth="@dimen/dimension_0"
            app:cardBackgroundColor="@color/gray1"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dimension_8"
            android:layout_weight="1">



            <TextView
                android:id="@+id/btnBackgroundColorTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="@dimen/dimension_2"
                android:text="@string/color"
                android:fontFamily="@font/londrina_solid_regular"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_3"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dimension_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBackgroundImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relative"
            app:spanCount="5"
            tools:itemCount="20"
            tools:listitem="@layout/item_background_image" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relative"
            app:spanCount="5"
            tools:itemCount="20"
            tools:listitem="@layout/item_background_color" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
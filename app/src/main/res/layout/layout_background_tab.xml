<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnlBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="220">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginVertical="10dp"
        android:layout_weight="40"
        android:elevation="2dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnBackgroundImage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imgAddBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/frame_bg_add"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/imgAddFor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/frame_select_add" />

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/btnBackgroundImageTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:text="@string/image"
                android:fontFamily="@font/atma_bold"
                app:outerStrokeColor="@color/app_color2"
                app:outerStrokeWidth="1dp"
                android:textColor="@color/white"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:textSize="20sp"
                tools:ignore="NestedWeights" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnBackgroundColor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imgAddBg1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/frame_bg_add"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/imgAddFor1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/frame_unselect_add" />

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/btnBackgroundColorTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:text="@string/color"
                android:fontFamily="@font/atma_bold"
                app:outerStrokeColor="@color/app_color2"
                app:outerStrokeWidth="1dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="188">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <RelativeLayout
                android:id="@+id/relative"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                app:layout_constraintDimensionRatio="3.6:0.38"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvtTittle"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:elevation="2dp"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/item_tittle_background_image"
                    />

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:elevation="1dp"
                    app:cardBackgroundColor="#40000000"
                    app:cardCornerRadius="1dp"
                    app:cardElevation="0dp"
                    android:layout_alignStart="@+id/rcvtTittle"
                    android:layout_alignEnd="@+id/rcvtTittle"
                    app:layout_constraintBottom_toBottomOf="@+id/rcvtTittle"
                    app:layout_constraintEnd_toEndOf="@+id/rcvtTittle"
                    app:layout_constraintStart_toStartOf="@+id/rcvtTittle"
                    app:layout_constraintTop_toTopOf="parent"

                    />
            </RelativeLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvBackgroundImage"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="7dp"
                app:layout_constraintTop_toBottomOf="@+id/relative"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_height="0dp"
                android:layout_marginTop="4.5dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="5"
                tools:listitem="@layout/item_background_image" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4.5dp"
            android:visibility="gone"
            android:layout_marginHorizontal="7dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="5"
            tools:listitem="@layout/item_background_color" />
    </FrameLayout>

</LinearLayout>
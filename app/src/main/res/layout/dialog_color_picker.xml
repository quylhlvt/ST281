<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="2dp"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="50dp"
            app:strokeWidth="0dp" >


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mater2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:elevation="1dp"
            app:cardBackgroundColor="@color/app_color5"
            app:cardCornerRadius="44dp"
            app:layout_constraintBottom_toBottomOf="@+id/mater"
            app:layout_constraintEnd_toEndOf="@+id/mater"
            app:layout_constraintStart_toStartOf="@+id/mater"
            app:layout_constraintTop_toTopOf="@+id/mater"
            app:strokeColor="@color/app_color4"
            app:strokeWidth="1dp">
  <com.google.android.material.card.MaterialCardView
            android:id="@+id/mater3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:elevation="1dp"
            app:cardBackgroundColor="@color/app_color3"
            app:cardCornerRadius="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/mater2"
            app:layout_constraintEnd_toEndOf="@+id/mater2"
            app:layout_constraintStart_toStartOf="@+id/mater2"
            app:layout_constraintTop_toTopOf="@+id/mater2"
            app:strokeColor="@color/app_color4"
            app:strokeWidth="1dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contrainColor"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            >

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeTextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fontFamily="@font/carter_one_regular"
                android:gravity="center"
                android:textColor="@color/white"
                app:outerStrokeWidth="1.8dp"
                app:outerStrokeColor="@color/app_color"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="20dp"
                android:text="@string/choose_color"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <ir.kotlin.quyhcolorpicker.QuylhColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                <ir.kotlin.quyhcolorpicker.QuylhHueSlider
                    android:id="@+id/hueSlider"
                    android:paddingHorizontal="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="34dp" />

                <!--                btnDone-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bg"
                    android:layout_marginTop="16dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/txtContent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnCancle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="5dp"
                        app:layout_constraintDimensionRatio="1.48:0.44"
                        app:layout_constraintEnd_toStartOf="@+id/btnSave"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/app_color2"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/imgCancleFor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/btn_chossecolor" />

                        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                            android:id="@+id/txtCancle"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/carter_one_regular"
                            android:gravity="center"
                            app:outerStrokeWidth="3dp"
                            app:outerStrokeColor="@color/app_color"
                            android:text="@string/cancel"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="5dp"
                        app:layout_constraintDimensionRatio="1.48:0.44"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/btnCancle"
                        app:layout_constraintTop_toTopOf="@+id/btnCancle"
                        app:strokeColor="@color/app_color2"
                        app:strokeWidth="1dp">


                        <ImageView
                            android:id="@+id/imgSaveFor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/btn_chossecolor" />

                        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                            android:id="@+id/txtSave"
                            style="@style/single_marquee"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/imgSaveFor"
                            app:layout_constraintTop_toTopOf="@+id/imgSaveFor"
                            app:layout_constraintBottom_toBottomOf="@+id/imgSaveFor"
                            android:fontFamily="@font/carter_one_regular"
                            android:gravity="center"
                            android:text="@string/save"
                            app:outerStrokeWidth="3dp"
                            app:outerStrokeColor="@color/app_color"
                            android:textColor="@color/white"
                            android:textSize="18sp"  />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
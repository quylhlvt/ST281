<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="3.59:0.8">
        <View
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="3.6:0.36"/>
        <View
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/view2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="3.6:0.08"/>

        <!--    btnActionBarLeft-->
        <ImageView
            android:id="@+id/btnActionBarLeft"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginStart="@dimen/dimension_16"

            android:src="@drawable/back_app"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:layout_constraintBottom_toTopOf="@+id/view2"
            app:layout_constraintStart_toStartOf="parent" />

        <!--    cvLogo-->
        <ImageView
            android:id="@+id/cvLogo"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginStart="@dimen/dimension_16"

            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:cardCornerRadius="@dimen/dimension_8"
            app:cardElevation="@dimen/dimension_0"
            android:scaleType="centerCrop"
            android:src="@drawable/back_app"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:layout_constraintBottom_toTopOf="@+id/view2"
            app:layout_constraintStart_toStartOf="parent"/>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintDimensionRatio="1.26:0.42"
            android:paddingHorizontal="@dimen/dimension_8"
            android:background="@drawable/bg_100_stroke_red"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight"
            app:layout_constraintStart_toEndOf="@+id/cvLogo"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft">

            <ImageView
                android:id="@+id/clock"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dimension_10"
                android:layout_marginVertical="@dimen/dimension_10"
                android:src="@drawable/clock"
                app:layout_constraintHorizontal_chainStyle="packed"/>

            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeTextView2
                android:id="@+id/tvCenter"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:ellipsize="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="@font/carter_one_regular"
                android:gravity="center"
                android:includeFontPadding="true"
                android:scrollHorizontally="false"
                android:singleLine="true"
                android:text="10:00"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_18"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clock"
                app:layout_constraintTop_toTopOf="parent"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_1_5" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--    tvStart-->
        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextViewPermission
            android:id="@+id/tvStart"
            style="@style/single_marquee"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_0"
            android:gravity="start|center_vertical"
            android:text="@string/language"
            android:textSize="@dimen/text_size_26"
            android:fontFamily="@font/carter_one_regular"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:outerStrokeColor="@color/app_color"
            app:outerStrokeWidth="@dimen/dimension_3"
            android:textColor="@color/white"
            />

        <!--    tvCenter-->


        <!--    btnActionBarCenter-->
        <ImageView
            android:id="@+id/btnActionBarCenter"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarCenter1"
            app:layout_constraintStart_toEndOf="@+id/btnActionBarLeft"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />
        <ImageView
            android:id="@+id/btnActionBarCenter1"
            android:layout_width="@dimen/dimension_36"
            android:layout_height="@dimen/dimension_36"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarCenter2"
            app:layout_constraintStart_toEndOf="@+id/btnActionBarCenter"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />
        <!--    btnActionBarCenter-->
        <ImageView
            android:id="@+id/btnActionBarCenter2"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight"
            app:layout_constraintStart_toEndOf="@+id/btnActionBarCenter1"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

        <!--    btnActionBarNextToRight-->
        <ImageView
            android:id="@+id/btnActionBarNextToRight"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginEnd="@dimen/dimension_5"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/view2"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight" />

        <!--    btnActionBarRight-->
        <ImageView
            android:id="@+id/btnActionBarRight"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"

            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginEnd="@dimen/dimension_16"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/view2"
            app:layout_constraintEnd_toEndOf="parent" />
        <ImageView
            android:id="@+id/btnActionBarNextToRight1"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginEnd="@dimen/dimension_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarRight1"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarRight1"

            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight1" />

        <ImageView
            android:id="@+id/btnActionBarRight1"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginVertical="@dimen/dimension_8"
            android:layout_marginEnd="@dimen/dimension_16"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarRight"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarRight" />

        <!--            btnActionBarRightText-->
        <FrameLayout
            android:id="@+id/btnActionBarRightText"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="0.7:0.3"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/dimension_16"
            android:background="@drawable/frame_select_language"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarRight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarRight">

            <TextView
                android:id="@+id/tvRightText"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/next"
                android:textColor="@color/white"
                android:textSize="@dimen/dimension_16" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


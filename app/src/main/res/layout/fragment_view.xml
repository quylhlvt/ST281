<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@drawable/img_bg_lang"
    android:clipToPadding="false"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.view.ViewFragment">



    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/app_color4"
    app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/imvImage"
        android:scaleType="centerCrop"
        android:src="@drawable/img_permission" />



    <!--    btnEdit-->
    <!--    <ImageView-->
    <!--        android:id="@+id/btnEdit"-->
    <!--        android:layout_width="32dp"-->
    <!--        android:visibility="gone"-->
    <!--        android:layout_height="32dp"-->
    <!--        android:layout_marginTop="10dp"-->
    <!--        android:layout_marginEnd="16dp"-->
    <!--        android:src="@drawable/ic_edit_2"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />-->

    <!--        tvSuccess-->


    <!--    lnlBottom-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3.28:0.48">


        <FrameLayout
            android:id="@+id/btnBottomLeft"
            android:layout_width="0dp"
            android:background="@drawable/frame_select_success"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.56:0.48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">



            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/txtLeft"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/share"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:outerStrokeColor="@color/app_color"
                android:fontFamily="@font/carter_one_regular"
                app:outerStrokeWidth="2dp" />
        </FrameLayout>


        <FrameLayout
            android:id="@+id/btnBottomRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/frame_select_success"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.56:0.48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">




            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/txtRight"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/download"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:outerStrokeColor="@color/app_color"
                android:fontFamily="@font/carter_one_regular"
                app:outerStrokeWidth="2dp"/>
        </FrameLayout>
        <!--        btnBottomRight-->

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlBottomSocial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/lnlBottom"
        app:layout_constraintDimensionRatio="3.28:0.48">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnBottomLeftSocial"
            android:layout_width="0dp"
            android:background="@drawable/img_bg_fb"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.56:0.48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageView
                android:id="@+id/iconFb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                android:src="@drawable/ic_fb"
                android:layout_marginVertical="15dp"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/txtLeftSocial"
                style="@style/single_marquee"
                android:layout_width="0dp"
                app:layout_constraintStart_toEndOf="@+id/iconFb"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/facebook_share"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/carter_one_regular"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnBottomRightSocial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/img_bg_ig"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.56:0.48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iconIg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                android:src="@drawable/ic_ig"
                android:layout_marginVertical="15dp"
                android:layout_marginStart="10dp"/>


            <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                android:id="@+id/txtRightSocial"
                style="@style/single_marquee"
                android:layout_width="0dp"
                android:layout_marginHorizontal="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/instagram_share"
                android:textColor="@color/white"
                app:layout_constraintStart_toEndOf="@+id/iconIg"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="14sp"
                android:fontFamily="@font/carter_one_regular"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--        btnBottomRight-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
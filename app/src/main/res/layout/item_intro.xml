<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:clipToOutline="false"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imvImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:scaleType="fitXY"
        android:elevation="@dimen/dimension_1"
        android:src="@drawable/img_intro1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContent"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimension_24"
        android:elevation="@dimen/dimension_2"
        android:gravity="center"
        android:fontFamily="@font/carter_one_regular"
        android:textColor="@color/app_color"
        app:outerStrokeWidth="@dimen/dimension_1_5"
        android:includeFontPadding="true"
        app:outerStrokeColor="@color/app_color"
        android:textSize="@dimen/text_size_18"
        android:layout_marginBottom="@dimen/dimension_24"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>

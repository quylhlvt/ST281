<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.fff.a.ui.onboarding.permission.PermissionFragment">
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimension_1"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <View
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="3.6:0.8"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7" />
    <ImageView

        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom1"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/bg_bottom_intro"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_bg_lang"
        android:scaleType="fitXY"
        android:elevation="-1dp"
        android:adjustViewBounds="true"/>

    <ImageView
        android:id="@+id/imgPermission"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_16"
        app:layout_constraintDimensionRatio="1:1"
        android:adjustViewBounds="true"
        android:src="@drawable/img_permission"
        app:layout_constraintBottom_toTopOf="@+id/scrollView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1" />

    <com.fff.a.core.extention.OuterStrokeShadownTextViewPermission
        android:id="@+id/txtPermission"
        android:layout_width="@dimen/dimension_0"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_20"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dimension_10"

        android:fontFamily="@font/atma_bold"
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/white"
        app:outerStrokeColor="@color/app_color"
        app:outerStrokeWidth="@dimen/dimension_2"
        app:layout_constraintBottom_toTopOf="@+id/scrollView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimension_12"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_20"
            android:orientation="vertical">

            <!-- btnStorage-->
            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="3.28:0.56"
                android:id="@+id/btnStorage"

                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:background="@drawable/bg_frame_permission">

                <TextView
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimension_24"
                    android:gravity="center_vertical"
                    style="@style/single_marquee"
                    android:text="@string/storage"
                    android:textColor="@color/app_color"
                    android:fontFamily="@font/carter_one_regular"
                    android:textSize="@dimen/text_size_16" />

                <ImageView
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/swPermission"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dimension_16"
                    app:layout_constraintDimensionRatio="3.6:2.4"
                    android:layout_marginEnd="@dimen/dimension_24"
                    android:src="@drawable/switch_off" />
            </androidx.constraintlayout.widget.ConstraintLayout>
<Space
    android:id="@+id/space"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_0"
    app:layout_constraintDimensionRatio="3.28:0.08"
    app:layout_constraintTop_toBottomOf="@+id/btnStorage"/>

            <!-- btnNotification-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnNotification"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"

                android:background="@drawable/bg_frame_permission"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="3.28:0.56"
                app:layout_constraintTop_toBottomOf="@+id/space">

                <TextView
                    style="@style/single_marquee"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimension_24"
                    android:fontFamily="@font/carter_one_regular"
                    android:gravity="center_vertical"
                    android:text="@string/notification"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/swNotification"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dimension_16"
                    android:layout_marginEnd="@dimen/dimension_24"
                    android:src="@drawable/switch_off"
                    app:layout_constraintDimensionRatio="3.6:2.4"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="3.6:0.16"
        android:id="@+id/view2"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottom1"
        />
    <TextView
        android:id="@+id/tvContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_12"
        android:gravity="center"
        android:fontFamily="@font/londrina_solid_regular"
        android:text="@string/continue_per"
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/app_color2"

        app:layout_constraintTop_toBottomOf="@+id/view2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
